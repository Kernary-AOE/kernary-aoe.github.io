---
import Base from '../layouts/Base.astro';
import ArchitectureViz from './ArchitectureViz.astro';
import { SITE } from '../config/site';

interface Props { lang?: 'en' | 'zh' }
const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';
const prefix = (path: string) => isZh ? `/zh${path}` : path;

const copy = isZh ? {
  eyebrow: 'Agent Ontology Engine',
  title: '定义领域，编译 Runtime。',
  lede: 'AOE 把外部领域本体与语料编译成可验证 Runtime。Agent 和应用可以查询 Snapshot、构建带约束的计划，并通过 SDK、MCP 或 HTTP 执行经过审批的 Action。',
  primary: '从文档开始', secondary: '理解 Package',
  fromTitle: '把领域接入 Agent 工作流',
  fromText: 'Model Package 描述类型、关系与行为，Corpus Package 提供可追溯内容。AOE 将两者编译为带 identity 的 Snapshot，供 Query、Plan 与 Action 使用。',
  schemaTitle: '用 Model 描述领域',
  schemaText: '从客服、合规、运维到设计，领域可以声明自己的 Type、Relation、Projection 与 Action，并沿用同一套 Engine。',
  splitTitle: '从选择进入行动',
  splitText: 'Query 生成 Selection Plan；需要改变状态时，再按 Principal、Capability、Policy、Approval 与 Evidence 执行 Action。',
  transportTitle: '一套契约，适配不同部署',
  transportText: 'Embedded SDK、MCP 与 HTTP 共享 Snapshot、Plan、Query 与 Action 契约，按部署方式选择接入层。',
  pathsTitle: '从你拥有的边界开始',
  paths: [
    ['连接 Agent', '使用已有 Domain Package，通过 SDK、MCP 或 HTTP 接入。', '/docs/start/connect-agent'],
    ['定义 Model', '声明 Type、Relation、Projection、Retrieval 与 Action。', '/docs/concepts/package-model'],
    ['发布 Corpus', '管理 Source、Provenance、License、Release 与签名。', '/docs/concepts/compilation-snapshots'],
    ['运维 Runtime', '处理 Lock、Activation、Migration、Rollback 与 Event replay。', '/docs/operate/releases-migrations'],
  ],
  examplesTitle: '从真实领域开始',
  examplesText: 'Ticket、Recipe、Security 与 Frontend Design 都是外部 Package。你可以从这些例子开始，也可以带着自己的 Model 与 Corpus 接入。',
} : {
  eyebrow: 'Agent Ontology Engine',
  title: 'Define a domain. Compile a runtime.',
  lede: 'AOE is an Agent Ontology Engine. It compiles an external domain ontology and corpus into a verified runtime that agents and applications can query, plan against, and act through SDK, MCP, or HTTP.',
  primary: 'Start with the docs', secondary: 'Understand packages',
  fromTitle: 'Bring a domain into an agent workflow',
  fromText: 'A Model Package describes types, relations, and behavior. A Corpus Package supplies traceable content. AOE compiles both into an identified Snapshot for Query, Plan, and Action.',
  schemaTitle: 'Model the domain you know',
  schemaText: 'Support, compliance, operations, and design domains can declare their own types, relations, projections, and actions on the same Engine.',
  splitTitle: 'Move from selection to action',
  splitText: 'Query produces a Selection Plan. When state must change, an Action follows principal, capability, policy, approval, and evidence requirements.',
  transportTitle: 'One contract, any host',
  transportText: 'Embedded SDK, MCP, and HTTP share Snapshot, Plan, Query, and Action contracts. Choose the integration layer that fits the deployment.',
  pathsTitle: 'Start from the boundary you own',
  paths: [
    ['Connect an Agent', 'Use an existing Domain Package through SDK, MCP, or HTTP.', '/docs/start/connect-agent'],
    ['Define a Model', 'Declare types, relations, projections, retrieval, and actions.', '/docs/concepts/package-model'],
    ['Publish a Corpus', 'Own sources, provenance, licences, releases, and signing.', '/docs/concepts/compilation-snapshots'],
    ['Operate a Runtime', 'Manage locks, activation, migration, rollback, and event replay.', '/docs/operate/releases-migrations'],
  ],
  examplesTitle: 'Start with a domain you know',
  examplesText: 'Ticket, Recipe, Security, and Frontend Design are external packages. Start with one of these examples or bring a Model and Corpus of your own.',
};
---
<Base title={SITE.name} current="home" lang={lang} description={isZh ? SITE.descriptionZh : SITE.description}>
  <section class="hero">
    <div class="hero-inner">
      <div>
        <p class="hero-eyebrow"><span class="pill">v{SITE.version}</span> {copy.eyebrow}</p>
        <h1>{copy.title}</h1>
        <p class="lede">{copy.lede}</p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-large" href={prefix('/docs')}>{copy.primary} →</a>
          <a class="btn btn-large" href={prefix('/docs/concepts/package-model')}>{copy.secondary}</a>
          <a class="btn btn-large" href={SITE.github} rel="noopener">GitHub ↗</a>
        </div>
        <p style="margin-top: 20px; color: var(--fg-muted); font-size: 13px;">
          External schemas · Reproducible snapshots · Policy-gated actions · SDK · MCP · HTTP
        </p>
      </div>
      <div class="hero-signal" aria-label={isZh ? 'AOE Runtime 信号' : 'AOE runtime signal'}>
        <div class="signal-top"><span>aoe / runtime</span><span class="signal-live"><i></i> live contract</span></div>
        <div class="signal-lines" aria-hidden="true">
          <span class="signal-line line-one"></span><span class="signal-line line-two"></span><span class="signal-line line-three"></span>
          <span class="signal-node node-model">Model</span><span class="signal-node node-snapshot">Snapshot</span><span class="signal-node node-action">Action</span>
        </div>
        <div class="signal-caption">{isZh ? '外部声明 · 可复现构建 · 受控执行' : 'External declarations · reproducible builds · governed execution'}</div>
      </div>
    </div>
  </section>

  <ArchitectureViz lang={lang} />

  <section class="section">
    <div class="section-inner">
      <p class="section-eyebrow">Runtime model</p>
      <h2 class="section-title" style="border: 0; padding: 0; margin-top: 0;">{copy.fromTitle}</h2>
      <p class="section-lede">{copy.fromText}</p>
      <div class="feat-grid">
        <article class="feat"><div class="feat-icon">{`{ }`}</div><h3>{copy.schemaTitle}</h3><p>{copy.schemaText}</p></article>
        <article class="feat"><div class="feat-icon">≠</div><h3>{copy.splitTitle}</h3><p>{copy.splitText}</p></article>
        <article class="feat"><div class="feat-icon">↔</div><h3>{copy.transportTitle}</h3><p>{copy.transportText}</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <p class="section-eyebrow">Start</p>
      <h2 class="section-title" style="border: 0; padding: 0; margin-top: 0;">{copy.pathsTitle}</h2>
      <div class="pack-grid">
        {copy.paths.map(([title, summary, href]) => (
          <a class="pack-card" href={prefix(href)}>
            <div class="pack-head"><h3 class="pack-name">{title}</h3></div>
            <p class="pack-desc">{summary}</p>
            <span style="color: var(--accent-fg); font-size: 14px;">{isZh ? '打开指南' : 'Open guide'} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <p class="section-eyebrow">Domain packages</p>
      <h2 class="section-title" style="border: 0; padding: 0; margin-top: 0;">{copy.examplesTitle}</h2>
      <p class="section-lede">{copy.examplesText}</p>
      <div class="chips" style="margin: 24px 0;"><code>Ticket</code><code>Recipe</code><code>Security</code><code>Frontend Design</code></div>
    </div>
  </section>
</Base>

<style>
  .hero-signal { min-height: 300px; border: 1px solid var(--border-default); border-radius: 14px; background: radial-gradient(circle at 50% 42%, color-mix(in srgb, var(--accent-emphasis) 12%, transparent), transparent 56%), var(--bg-subtle); overflow: hidden; position: relative; }
  .signal-top { display: flex; justify-content: space-between; padding: 14px 16px; color: var(--fg-muted); font: 11px var(--font-mono); letter-spacing: .05em; text-transform: uppercase; border-bottom: 1px solid var(--border-muted); }
  .signal-live { color: var(--success-fg); }
  .signal-live i { display: inline-block; width: 6px; height: 6px; margin-right: 5px; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 4px color-mix(in srgb, currentColor 18%, transparent); animation: signal-pulse 1.8s ease-in-out infinite; }
  .signal-lines { position: relative; min-height: 230px; }
  .signal-line { position: absolute; height: 1px; transform-origin: left center; background: linear-gradient(90deg, transparent, var(--accent-emphasis), transparent); opacity: .8; animation: signal-flow 2.8s ease-in-out infinite; }
  .line-one { left: 23%; top: 48%; width: 27%; transform: rotate(-20deg); }
  .line-two { left: 28%; top: 54%; width: 45%; }
  .line-three { left: 54%; top: 56%; width: 25%; transform: rotate(-26deg); animation-delay: .45s; }
  .signal-node { position: absolute; display: grid; place-items: center; border: 1px solid var(--accent-emphasis); color: var(--fg-default); background: var(--bg-canvas); border-radius: 12px; padding: 15px 18px; font: 13px var(--font-mono); box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent-emphasis) 8%, transparent); }
  .node-model { left: 12%; top: 38%; }
  .node-snapshot { left: 43%; top: 48%; border-color: #6f7bf7; box-shadow: 0 0 0 6px color-mix(in srgb, #6f7bf7 12%, transparent); }
  .node-action { right: 12%; top: 31%; border-color: var(--success-fg); box-shadow: 0 0 0 6px color-mix(in srgb, var(--success-fg) 10%, transparent); }
  .signal-caption { position: absolute; bottom: 16px; left: 16px; right: 16px; color: var(--fg-muted); font-size: 12px; line-height: 1.5; }
  @keyframes signal-flow { 0%, 100% { opacity: .28; } 50% { opacity: 1; } }
  @keyframes signal-pulse { 0%, 100% { opacity: .5; } 50% { opacity: 1; } }
  @media (max-width: 720px) { .hero-signal { min-height: 260px; } .node-model { left: 8%; } .node-action { right: 8%; } .node-snapshot { left: 38%; } }
  @media (prefers-reduced-motion: reduce) { .signal-line, .signal-live i { animation: none; } }
</style>
