---
import '../styles/home.css';
import Base from '../layouts/Base.astro';
import HomeHero from './home/HomeHero.astro';
import HomeProof from './home/HomeProof.astro';
import HomePillars from './home/HomePillars.astro';
import HomeStages from './home/HomeStages.astro';
import HomeConnect from './home/HomeConnect.astro';
import HomeSteps from './home/HomeSteps.astro';
import HomeFaq from './home/HomeFaq.astro';
import HomeCta from './home/HomeCta.astro';
import { HOME_COPY } from '../data/home-copy';
import { SITE } from '../config/site';
import { loadAll } from '../lib/corpus';

interface Props { lang?: 'en' | 'zh' }
const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';
const prefix = (path: string) => isZh ? `/zh${path}` : path;
const copy = HOME_COPY[lang];

const { corpora } = loadAll();
const packages = [...corpora].sort((a, b) => a.slug.localeCompare(b.slug)).map((c) => ({ slug: c.slug, units: c.total }));
const stats = {
  packages: corpora.length,
  units: corpora.reduce((sum, c) => sum + c.total, 0),
  types: new Set(corpora.flatMap((c) => c.atoms.map((a) => a.kind))).size,
  transports: 3,
};
---

<Base title={SITE.name} current="home" lang={lang} description={isZh ? SITE.descriptionZh : SITE.description}>
  <script is:inline>document.documentElement.classList.add('js');</script>
  <div class="home">
    <HomeHero copy={copy.hero} prefix={prefix} />
    <HomeProof copy={copy.proof} lang={lang} stats={stats} packages={packages} />
    <HomePillars copy={copy.pillars} />
    <HomeStages copy={copy.stages} />
    <HomeConnect copy={copy.connect} lang={lang} prefix={prefix} />
    <HomeSteps copy={copy.steps} prefix={prefix} />
    <HomeFaq copy={copy.faq} />
    <HomeCta copy={copy.cta} prefix={prefix} github={SITE.github} />
  </div>
</Base>

<script>
  import { initHomeMotion } from '../scripts/home-motion';
  initHomeMotion();
</script>
