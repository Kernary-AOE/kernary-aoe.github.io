---
import Base from '../layouts/Base.astro';
import ArchitectureViz from './ArchitectureViz.astro';
import { SITE } from '../config/site';

interface Props { lang?: 'en' | 'zh' }
const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';
const prefix = (path: string) => isZh ? `/zh${path}` : path;

const copy = isZh ? {
  announcement: 'AOE 0.2 · Agent Ontology Engine',
  eyebrow: 'Agent Ontology Engine',
  title: '让领域知识，\n成为可运行的系统。',
  lede: 'AOE 将外部 Model、Corpus 与 Adapter 编译为可验证 Runtime。Agent 和应用通过同一套契约查询、规划，并执行受治理的 Action。',
  primary: '开始构建', secondary: '浏览 Package',
  signal: '正在编译领域契约', signalFoot: 'Model → Snapshot → Agent',
  introKicker: '一个运行时，承载你的领域',
  introTitle: '从声明开始，直到行动发生。',
  introText: '把领域词汇、关系、来源和行为放在你自己的 Package 中。AOE 负责编译、验证、检索和执行边界。',
  cards: [
    ['01', '定义领域词汇', 'Model Package 声明 Type、Relation、Projection、Retrieval 与 Action。', 'Model Package'],
    ['02', '发布可验证快照', 'Corpus Package 带着来源、许可证、版本和摘要进入确定性构建。', 'Corpus Package'],
    ['03', '连接 Agent 与应用', 'Embedded SDK、MCP 与 HTTP 共享 Snapshot、Selection Plan 和 Execution Plan。', 'Integration'],
  ],
  connectKicker: '选择你的入口',
  connectTitle: '把 Runtime 接到你的工作流。',
  connectText: '同一份 Model 与 Corpus，可以嵌入进程、挂载到 MCP，或通过 HTTP 部署。',
  tabs: [
    ['sdk', 'Embedded SDK', '在应用进程中直接调用。', `import { AoeClient } from '@aoe/sdk';\n\nconst aoe = new AoeClient({\n  snapshot: './dist/snapshot',\n});\n\nconst plan = await aoe.query({\n  text: 'resolve an incident',\n});`],
    ['mcp', 'MCP', '让 Agent 直接发现工具。', `AOE_CORPUS_DIR=./dist \\\n  bun run @aoe/mcp-server-core\n\n// tools exposed by the Model Package\naoe_query({ query: 'resolve an incident' })\naoe_plan({ query: 'resolve an incident' })`],
    ['http', 'HTTP', '把契约放到服务边界。', `curl -X POST https://runtime.example/v1/query \\\n  -H 'Authorization: Bearer $AOE_TOKEN' \\\n  -d '{"query":"resolve an incident"}'\n\n// response: SelectionPlan + snapshot identity`],
  ],
  ctaKicker: 'Start with your domain',
  ctaTitle: '你的领域，下一步是什么？',
  ctaText: '从一个小型 Model 和 Corpus 开始，在几分钟内得到可以查询的 Runtime。',
  ctaPrimary: '阅读五分钟指南', ctaSecondary: '查看源码',
} : {
  announcement: 'AOE 0.2 · Agent Ontology Engine',
  eyebrow: 'Agent Ontology Engine',
  title: 'Make domain knowledge\noperational.',
  lede: 'AOE compiles external Models, Corpora, and Adapters into a verified runtime. Agents and applications query, plan, and execute through one contract.',
  primary: 'Start building', secondary: 'Browse packages',
  signal: 'COMPILING DOMAIN CONTRACT', signalFoot: 'Model → Snapshot → Agent',
  introKicker: 'One runtime for the domain you own',
  introTitle: 'Start with a declaration. End at an action.',
  introText: 'Keep vocabulary, relationships, sources, and behavior in your own packages. AOE owns compilation, verification, retrieval, and execution boundaries.',
  cards: [
    ['01', 'Define the vocabulary', 'A Model Package declares types, relations, projections, retrieval, and actions.', 'Model Package'],
    ['02', 'Publish a verified snapshot', 'A Corpus Package brings sources, licences, versions, and digests into a deterministic build.', 'Corpus Package'],
    ['03', 'Connect agents and apps', 'Embedded SDK, MCP, and HTTP share Snapshot, Selection Plan, and Execution Plan contracts.', 'Integration'],
  ],
  connectKicker: 'Choose your entry point',
  connectTitle: 'Put the runtime in your workflow.',
  connectText: 'The same Model and Corpus can run in-process, mount through MCP, or sit behind an HTTP boundary.',
  tabs: [
    ['sdk', 'Embedded SDK', 'Call it inside your application.', `import { AoeClient } from '@aoe/sdk';\n\nconst aoe = new AoeClient({\n  snapshot: './dist/snapshot',\n});\n\nconst plan = await aoe.query({\n  text: 'resolve an incident',\n});`],
    ['mcp', 'MCP', 'Let an agent discover the tools.', `AOE_CORPUS_DIR=./dist \\\n  bun run @aoe/mcp-server-core\n\n// tools exposed by the Model Package\naoe_query({ query: 'resolve an incident' })\naoe_plan({ query: 'resolve an incident' })`],
    ['http', 'HTTP', 'Place the contract at a service boundary.', `curl -X POST https://runtime.example/v1/query \\\n  -H 'Authorization: Bearer $AOE_TOKEN' \\\n  -d '{"query":"resolve an incident"}'\n\n// response: SelectionPlan + snapshot identity`],
  ],
  ctaKicker: 'Start with your domain',
  ctaTitle: 'What will your domain do next?',
  ctaText: 'Start with a small Model and Corpus. In minutes, you have a runtime that can be queried and inspected.',
  ctaPrimary: 'Read the five-minute guide', ctaSecondary: 'View the source',
};
---

<Base title={SITE.name} current="home" lang={lang} description={isZh ? SITE.descriptionZh : SITE.description}>
  <div class="aoe-home">
    <div class="home-progress" aria-hidden="true"><span></span></div>

    <section class="aoe-hero">
      <div class="hero-noise" aria-hidden="true"></div>
      <div class="hero-inner aoe-hero-inner">
        <div class="hero-copy" data-reveal>
          <a class="announcement" href={prefix('/blog')}><span class="announcement-dot"></span>{copy.announcement}<span>↗</span></a>
          <p class="hero-eyebrow"><span class="hero-kicker">{copy.eyebrow}</span></p>
          <h1>{copy.title}</h1>
          <p class="lede">{copy.lede}</p>
          <div class="hero-cta">
            <a class="btn btn-primary btn-large" href={prefix('/docs')}>{copy.primary} <span>↗</span></a>
            <a class="btn btn-dark-ghost btn-large" href={prefix('/marketplace')}>{copy.secondary}</a>
          </div>
          <div class="hero-trail"><span>External Model</span><i>·</i><span>Verified Snapshot</span><i>·</i><span>Governed Action</span></div>
        </div>

        <div class="hero-console" data-reveal aria-label={isZh ? 'AOE Runtime 状态' : 'AOE runtime status'}>
          <div class="console-head"><span class="console-brand"><i></i> aoe / runtime</span><span>v{SITE.version}</span></div>
          <div class="console-body">
            <div class="console-status"><span class="status-light"></span><span>{copy.signal}</span><span class="status-time">00:02.84</span></div>
            <div class="console-orbit" aria-hidden="true">
              <span class="orbit-ring ring-a"></span><span class="orbit-ring ring-b"></span><span class="orbit-ring ring-c"></span>
              <span class="orbit-node orbit-model">MODEL</span><span class="orbit-node orbit-corpus">CORPUS</span><span class="orbit-node orbit-snapshot">SNAPSHOT</span><span class="orbit-node orbit-agent">AGENT</span>
              <span class="orbit-core"><img src="/aoe-mark.svg" alt="" width="28" height="28" /></span>
            </div>
            <div class="console-foot"><span>{copy.signalFoot}</span><span class="console-check">✓ verified</span></div>
          </div>
        </div>
      </div>
      <div class="hero-edge"><span>AOE / 0.2</span><span>{isZh ? '面向领域本体的基础设施' : 'Infrastructure for domain ontologies'}</span><span>↓</span></div>
    </section>

    <section class="home-section intro-section">
      <div class="section-inner">
        <div class="section-lead" data-reveal><p class="section-eyebrow">{copy.introKicker}</p><h2>{copy.introTitle}</h2><p>{copy.introText}</p></div>
        <div class="boundary-grid">
          {copy.cards.map(([number, title, text, label], index) => (
            <article class:list={{ 'boundary-card': true, 'boundary-card-featured': index === 1 }} data-reveal>
              <div class="boundary-top"><span>{number}</span><span>{label}</span></div>
              <div class="boundary-mark">{index === 0 ? '◇' : index === 1 ? '◌' : '↗'}</div>
              <h3>{title}</h3><p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <ArchitectureViz lang={lang} />

    <section class="home-section connect-section">
      <div class="section-inner connect-inner">
        <div class="connect-copy" data-reveal><p class="section-eyebrow">{copy.connectKicker}</p><h2>{copy.connectTitle}</h2><p>{copy.connectText}</p><a class="text-link" href={prefix('/docs/start/connect-agent')}>{isZh ? '查看接入指南' : 'Read the integration guide'} <span>↗</span></a></div>
        <div class="integration-panel" data-reveal>
          <div class="integration-tabs" role="tablist" aria-label={isZh ? '接入方式' : 'Integration methods'}>
            {copy.tabs.map(([id, label, description, snippet], index) => <button class:list={{ active: index === 0 }} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-tab={id} data-label={label} data-code={snippet}><span>{label}</span><small>{description}</small></button>)}
          </div>
          <div class="integration-code"><div class="code-chrome"><span><i></i><i></i><i></i></span><span id="integration-label">{copy.tabs[0][1]}</span><button id="copy-integration" type="button">{isZh ? '复制' : 'Copy'}</button></div><pre id="integration-code" class="no-copy"><code>{copy.tabs[0][3]}</code></pre></div>
        </div>
      </div>
    </section>

    <section class="home-section package-section">
      <div class="section-inner package-inner" data-reveal>
        <div><p class="section-eyebrow">{isZh ? '外部 Package' : 'External packages'}</p><h2>{isZh ? '模型属于领域 Owner。' : 'The model belongs to its domain owner.'}</h2></div>
        <div><p>{isZh ? 'AOE 不携带一套生产本体。Ticket、Recipe、Security 和 Frontend Design 都是可替换的外部 Package；它们只共享 Engine 契约。' : 'AOE does not ship a production ontology. Ticket, Recipe, Security, and Frontend Design are replaceable external packages; they share the Engine contract, not a built-in vocabulary.'}</p><a class="text-link" href={prefix('/marketplace')}>{isZh ? '浏览全部 Package' : 'Explore all packages'} <span>↗</span></a></div>
      </div>
    </section>

    <section class="aoe-cta-section">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="cta-inner" data-reveal><p class="section-eyebrow">{copy.ctaKicker}</p><h2>{copy.ctaTitle}</h2><p>{copy.ctaText}</p><div class="cta-actions"><a class="btn btn-primary btn-large" href={prefix('/docs')}>{copy.ctaPrimary} <span>↗</span></a><a class="btn btn-dark-ghost btn-large" href={SITE.github} rel="noopener">{copy.ctaSecondary} <span>↗</span></a></div></div>
    </section>
  </div>
</Base>

<script>
  const page = document.querySelector('.aoe-home');
  if (page) {
    const bar = page.querySelector('.home-progress span') as HTMLElement | null;
    const updateProgress = () => { if (!bar) return; const max = document.documentElement.scrollHeight - window.innerHeight; bar.style.transform = `scaleX(${max > 0 ? window.scrollY / max : 0})`; };
    window.addEventListener('scroll', updateProgress, { passive: true }); updateProgress();

    const reveal = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); reveal.unobserve(entry.target); } }), { threshold: .12 });
    page.querySelectorAll('[data-reveal]').forEach((element) => reveal.observe(element));

    const tabs = Array.from(page.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const code = page.querySelector('#integration-code code'); const label = page.querySelector('#integration-label'); const copyButton = page.querySelector('#copy-integration');
    tabs.forEach((tab) => tab.addEventListener('click', () => { tabs.forEach((item) => { const active = item === tab; item.classList.toggle('active', active); item.setAttribute('aria-selected', String(active)); }); const snippet = tab.dataset.code; const name = tab.dataset.label; if (snippet && name && code && label) { code.textContent = snippet; label.textContent = name; } }));
    copyButton?.addEventListener('click', async () => { if (!code || !copyButton) return; await navigator.clipboard.writeText(code.textContent || ''); const original = copyButton.textContent; copyButton.textContent = { zh: '已复制', en: 'Copied' }[document.documentElement.lang.startsWith('zh') ? 'zh' : 'en'] || 'Copied'; window.setTimeout(() => { copyButton.textContent = original; }, 1200); });
  }
</script>

<style>
  :global(body.aoe-home-body) { background: #f5f2ed; }
  :global(body.aoe-home-body .gh-header) { position: absolute; top: 0; left: 0; right: 0; z-index: 20; background: transparent; border-bottom-color: rgba(255,255,255,.12); }
  :global(body.aoe-home-body .gh-brand), :global(body.aoe-home-body .gh-nav a), :global(body.aoe-home-body .gh-meta a), :global(body.aoe-home-body .theme-toggle) { color: rgba(255,255,255,.78); }
  :global(body.aoe-home-body .gh-brand:hover), :global(body.aoe-home-body .gh-nav a:hover), :global(body.aoe-home-body .gh-meta a:hover), :global(body.aoe-home-body .theme-toggle:hover) { color: #fff; background: rgba(255,255,255,.1); }
  :global(body.aoe-home-body .gh-brand-tag) { color: rgba(255,255,255,.65); border-color: rgba(255,255,255,.2); background: rgba(255,255,255,.08); }
  :global(body.aoe-home-body .gh-search input) { color: #fff; border-color: rgba(255,255,255,.2); background: rgba(255,255,255,.08); }
  :global(body.aoe-home-body .gh-search input::placeholder) { color: rgba(255,255,255,.55); }
  .aoe-home { --ink: #11131b; --paper: #f5f2ed; --paper-deep: #ebe6de; --muted: #77736e; --line: rgba(17,19,27,.15); --cyan: #55d8e5; --violet: #7569f6; --coral: #f18e74; color: var(--ink); overflow: hidden; }
  .home-progress { position: fixed; top: 0; left: 0; right: 0; z-index: 40; height: 2px; pointer-events: none; background: transparent; } .home-progress span { display: block; height: 100%; width: 100%; transform: scaleX(0); transform-origin: left; background: linear-gradient(90deg, var(--cyan), var(--violet)); }
  .aoe-hero { min-height: 100svh; display: flex; flex-direction: column; position: relative; color: #f5f4f1; background: var(--ink); }
  .hero-noise { position: absolute; inset: 0; opacity: .16; pointer-events: none; background-image: radial-gradient(rgba(255,255,255,.24) .7px, transparent .7px); background-size: 5px 5px; mask-image: linear-gradient(150deg, black, transparent 70%); }
  .aoe-hero::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 75% 38%, rgba(117,105,246,.26), transparent 32%), radial-gradient(ellipse at 16% 74%, rgba(85,216,229,.1), transparent 28%); }
  .aoe-hero-inner { position: relative; z-index: 1; width: min(1240px, calc(100% - 48px)); margin: auto; padding: 150px 0 80px; display: grid; grid-template-columns: minmax(0, .94fr) minmax(420px, 1.06fr); gap: clamp(48px, 8vw, 120px); align-items: center; }
  .hero-copy { max-width: 620px; } .announcement { display: inline-flex; align-items: center; gap: 9px; color: rgba(255,255,255,.72); font: 11px var(--font-mono); letter-spacing: .05em; text-transform: uppercase; text-decoration: none; margin-bottom: 54px; } .announcement:hover { color: #fff; text-decoration: none; } .announcement > span:last-child { color: var(--cyan); margin-left: 3px; } .announcement-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 0 5px rgba(85,216,229,.12); }
  .hero-eyebrow { margin: 0 0 20px; color: var(--cyan); font: 12px var(--font-mono); letter-spacing: .13em; text-transform: uppercase; } .hero-kicker::before { content: '↳ '; color: rgba(255,255,255,.45); }
  .hero-copy h1 { max-width: 760px; margin: 0 0 28px; white-space: pre-line; color: #f5f4f1; font: 400 clamp(54px, 6.7vw, 100px)/.94 Georgia, 'Times New Roman', serif; letter-spacing: -.055em; }
  .hero-copy .lede { max-width: 560px; margin: 0; color: rgba(245,244,241,.68); font-size: clamp(16px, 1.45vw, 20px); line-height: 1.55; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 38px; } .btn-dark-ghost { color: #f5f4f1; background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.22); } .btn-dark-ghost:hover { color: #fff; background: rgba(255,255,255,.16); border-color: rgba(255,255,255,.4); }
  .hero-trail { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 52px; color: rgba(255,255,255,.44); font: 11px var(--font-mono); text-transform: uppercase; letter-spacing: .04em; } .hero-trail i { color: var(--violet); font-style: normal; }
  .hero-console { align-self: center; border: 1px solid rgba(255,255,255,.22); border-radius: 20px; background: rgba(16,18,27,.58); box-shadow: 0 30px 100px rgba(0,0,0,.34); backdrop-filter: blur(12px); overflow: hidden; } .console-head, .console-foot { display: flex; justify-content: space-between; align-items: center; color: rgba(255,255,255,.46); font: 11px var(--font-mono); letter-spacing: .05em; text-transform: uppercase; } .console-head { padding: 16px 18px; border-bottom: 1px solid rgba(255,255,255,.13); } .console-brand { color: rgba(255,255,255,.82); } .console-brand i { display: inline-block; width: 7px; height: 7px; margin-right: 7px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 0 4px rgba(85,216,229,.12); } .console-body { padding: 22px 24px 18px; } .console-status { display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,.78); font: 11px var(--font-mono); letter-spacing: .06em; text-transform: uppercase; } .status-light { width: 6px; height: 6px; border-radius: 50%; background: #64e38a; box-shadow: 0 0 0 4px rgba(100,227,138,.12); } .status-time { margin-left: auto; color: rgba(255,255,255,.34); }
  .console-orbit { position: relative; min-height: 390px; margin: 12px 0 8px; display: grid; place-items: center; } .orbit-ring { position: absolute; border: 1px solid rgba(255,255,255,.12); border-radius: 50%; transform: rotate(-22deg); } .ring-a { width: 245px; height: 245px; } .ring-b { width: 350px; height: 155px; border-color: rgba(85,216,229,.22); animation: orbit-spin 18s linear infinite; } .ring-c { width: 440px; height: 285px; border-color: rgba(117,105,246,.19); transform: rotate(27deg); animation: orbit-spin-reverse 25s linear infinite; } .orbit-node { position: absolute; padding: 9px 11px; border: 1px solid rgba(255,255,255,.2); border-radius: 999px; color: rgba(255,255,255,.74); background: rgba(255,255,255,.07); font: 10px var(--font-mono); letter-spacing: .08em; } .orbit-model { top: 20%; left: 13%; border-color: rgba(85,216,229,.55); } .orbit-corpus { bottom: 17%; left: 12%; border-color: rgba(241,142,116,.55); } .orbit-snapshot { top: 15%; right: 10%; border-color: rgba(117,105,246,.65); } .orbit-agent { bottom: 19%; right: 13%; border-color: rgba(100,227,138,.55); } .orbit-core { position: relative; z-index: 2; width: 76px; height: 76px; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.55); border-radius: 50%; background: radial-gradient(circle, rgba(117,105,246,.6), rgba(17,19,27,.95) 68%); box-shadow: 0 0 0 12px rgba(117,105,246,.08), 0 0 50px rgba(117,105,246,.4); animation: core-breathe 4s ease-in-out infinite; } .orbit-core img { filter: brightness(0) invert(1); } .console-foot { padding-top: 12px; border-top: 1px solid rgba(255,255,255,.11); } .console-check { color: #64e38a; }
  .hero-edge { position: relative; z-index: 1; display: flex; justify-content: space-between; width: min(1240px, calc(100% - 48px)); margin: auto auto 0; padding: 16px 0 18px; border-top: 1px solid rgba(255,255,255,.16); color: rgba(255,255,255,.4); font: 10px var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .home-section { background: var(--paper); } .section-inner { width: min(1240px, calc(100% - 48px)); margin: 0 auto; } .intro-section { padding: 140px 0 150px; } .section-lead { max-width: 680px; } .section-eyebrow { margin: 0 0 18px; color: var(--violet); font: 11px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; } .section-lead h2, .connect-copy h2, .package-inner h2 { margin: 0; color: var(--ink); font: 400 clamp(38px, 5vw, 68px)/.98 Georgia, 'Times New Roman', serif; letter-spacing: -.05em; } .section-lead > p:last-child, .connect-copy > p, .package-inner > div:last-child p { max-width: 570px; margin: 25px 0 0; color: var(--muted); font-size: 17px; line-height: 1.6; }
  .boundary-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 90px; } .boundary-card { min-height: 330px; padding: 22px 24px 26px; border: 1px solid var(--line); border-radius: 3px; background: rgba(255,255,255,.18); transition: transform 250ms ease, background 250ms ease, border-color 250ms ease; } .boundary-card:hover { transform: translateY(-7px); background: rgba(255,255,255,.62); border-color: rgba(17,19,27,.34); } .boundary-card-featured { background: #d8d8ff; border-color: rgba(117,105,246,.3); } .boundary-top { display: flex; justify-content: space-between; color: var(--muted); font: 10px var(--font-mono); letter-spacing: .08em; text-transform: uppercase; } .boundary-mark { margin-top: 74px; color: var(--violet); font: 32px Georgia, serif; } .boundary-card:nth-child(2) .boundary-mark { color: var(--coral); } .boundary-card:nth-child(3) .boundary-mark { color: #3eaa9b; } .boundary-card h3 { margin: 20px 0 10px; font: 400 26px/1.05 Georgia, serif; letter-spacing: -.035em; } .boundary-card p { max-width: 34ch; margin: 0; color: var(--muted); font-size: 14px; line-height: 1.55; }
