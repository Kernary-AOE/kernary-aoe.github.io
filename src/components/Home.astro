---
import Base from '../layouts/Base.astro';
import { SITE } from '../config/site';

interface Props { lang?: 'en' | 'zh' }
const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';
const prefix = (path: string) => isZh ? `/zh${path}` : path;

const copy = isZh ? {
  eyebrow: '模型驱动的本体基础设施',
  title: '给你的领域一个可以运行的本体。',
  lede: 'AOE 把外部领域本体与语料编译成可验证 Runtime。Agent 和应用可以查询 Snapshot、构建带约束的计划，并通过 SDK、MCP 或 HTTP 执行经过审批的 Action。',
  primary: '从文档开始', secondary: '理解 Package',
  fromTitle: '从本体到 Runtime',
  fromText: 'Model Package 定义本体、语义与行为，Corpus Package 提供内容与发布策略。Compiler 生成带 identity 的不可变 Snapshot；Query 与 Action Runtime 在同一套 Contract 上工作。',
  schemaTitle: '你的本体留在引擎外',
  schemaText: 'Ticket 和 Frontend Design 可以声明完全不同的 Type、Relation、Projection 与 Action。新增领域不需要修改 Parser、Compiler 或 Runtime。',
  splitTitle: 'Selection 不是 Permission',
  splitText: 'Query 返回 Selection Plan。Action 还要经过 Principal、Capability、Preflight、Policy、Approval、Idempotency 与 Event evidence。读取能力不会自动变成写权限。',
  transportTitle: '一个 Runtime，三种 Transport',
  transportText: 'Embedded SDK、MCP 与 HTTP 暴露同一 Snapshot 和 Plan Contract。Transport 解决部署问题，不复制领域逻辑。',
  pathsTitle: '从你拥有的边界开始',
  paths: [
    ['连接 Agent', '使用已有 Domain Package，通过 SDK、MCP 或 HTTP 接入。', '/docs/start/connect-agent'],
    ['定义 Model', '声明 Type、Relation、Projection、Retrieval 与 Action。', '/docs/concepts/package-model'],
    ['发布 Corpus', '管理 Source、Provenance、License、Release 与签名。', '/docs/concepts/compilation-snapshots'],
    ['运维 Runtime', '处理 Lock、Activation、Migration、Rollback 与 Event replay。', '/docs/operate/releases-migrations'],
  ],
  examplesTitle: '从真实领域开始',
  examplesText: 'Ticket、Recipe、Security 与 Frontend Design 都是外部 Package。你可以从这些例子开始，也可以带着自己的 Model 与 Corpus 接入。',
} : {
  eyebrow: 'Model-driven ontology infrastructure',
  title: 'An ontology your software can run.',
  lede: 'AOE is an Agent Ontology Engine. It compiles an external domain ontology and corpus into a verified runtime that agents and applications can query, plan against, and act through SDK, MCP, or HTTP.',
  primary: 'Start with the docs', secondary: 'Understand packages',
  fromTitle: 'From ontology to runtime',
  fromText: 'A Model Package defines the ontology and behavior. A Corpus Package supplies content and release policy. The compiler produces an immutable, identified snapshot used by both query and action runtimes.',
  schemaTitle: 'Your ontology stays outside the engine',
  schemaText: 'Ticket and Frontend Design can declare unrelated types, relations, projections, and actions. Adding a domain does not require a parser, compiler, or runtime change.',
  splitTitle: 'Selection is not permission',
  splitText: 'Query returns a Selection Plan. Action still requires principal, capability, preflight, policy, approval, idempotency, and event evidence. Read access never becomes write authority by implication.',
  transportTitle: 'One runtime, three transports',
  transportText: 'The embedded SDK, MCP, and HTTP expose the same snapshot and plan contracts. A transport solves deployment; it does not duplicate domain logic.',
  pathsTitle: 'Start from the boundary you own',
  paths: [
    ['Connect an Agent', 'Use an existing Domain Package through SDK, MCP, or HTTP.', '/docs/start/connect-agent'],
    ['Define a Model', 'Declare types, relations, projections, retrieval, and actions.', '/docs/concepts/package-model'],
    ['Publish a Corpus', 'Own sources, provenance, licences, releases, and signing.', '/docs/concepts/compilation-snapshots'],
    ['Operate a Runtime', 'Manage locks, activation, migration, rollback, and event replay.', '/docs/operate/releases-migrations'],
  ],
  examplesTitle: 'Start with a domain you know',
  examplesText: 'Ticket, Recipe, Security, and Frontend Design are external packages. Start with one of these examples or bring a Model and Corpus of your own.',
};
---
<Base title={SITE.name} current="home" lang={lang} description={isZh ? SITE.descriptionZh : SITE.description}>
  <section class="hero">
    <div class="hero-inner">
      <div>
        <p class="hero-eyebrow"><span class="pill">v{SITE.version}</span> {copy.eyebrow}</p>
        <h1>{copy.title}</h1>
        <p class="lede">{copy.lede}</p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-large" href={prefix('/docs')}>{copy.primary} →</a>
          <a class="btn btn-large" href={prefix('/docs/concepts/package-model')}>{copy.secondary}</a>
          <a class="btn btn-large" href={SITE.github} rel="noopener">GitHub ↗</a>
        </div>
        <p style="margin-top: 20px; color: var(--fg-muted); font-size: 13px;">
          External schemas · Reproducible snapshots · Policy-gated actions · SDK · MCP · HTTP
        </p>
      </div>
      <div class="hero-snippet" aria-label={isZh ? 'AOE 数据流' : 'AOE data flow'}>
        <div class="hero-snippet-head"><span>aoe</span><span>package → runtime</span></div>
        <pre><code>{`Model Package + Corpus Package
               │
       compiler + checks
               │
       immutable snapshot
          ┌────┴────┐
 Selection Plan  Execution Plan
          └────┬────┘
        SDK · MCP · HTTP`}</code></pre>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <p class="section-eyebrow">Runtime model</p>
      <h2 class="section-title" style="border: 0; padding: 0; margin-top: 0;">{copy.fromTitle}</h2>
      <p class="section-lede">{copy.fromText}</p>
      <div class="feat-grid">
        <article class="feat"><div class="feat-icon">{`{ }`}</div><h3>{copy.schemaTitle}</h3><p>{copy.schemaText}</p></article>
        <article class="feat"><div class="feat-icon">≠</div><h3>{copy.splitTitle}</h3><p>{copy.splitText}</p></article>
        <article class="feat"><div class="feat-icon">↔</div><h3>{copy.transportTitle}</h3><p>{copy.transportText}</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <p class="section-eyebrow">Start</p>
      <h2 class="section-title" style="border: 0; padding: 0; margin-top: 0;">{copy.pathsTitle}</h2>
      <div class="pack-grid">
        {copy.paths.map(([title, summary, href]) => (
          <a class="pack-card" href={prefix(href)}>
            <div class="pack-head"><h3 class="pack-name">{title}</h3></div>
            <p class="pack-desc">{summary}</p>
            <span style="color: var(--accent-fg); font-size: 14px;">{isZh ? '打开指南' : 'Open guide'} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <p class="section-eyebrow">Domain packages</p>
      <h2 class="section-title" style="border: 0; padding: 0; margin-top: 0;">{copy.examplesTitle}</h2>
      <p class="section-lede">{copy.examplesText}</p>
      <div class="chips" style="margin: 24px 0;"><code>Ticket</code><code>Recipe</code><code>Security</code><code>Frontend Design</code></div>
    </div>
  </section>
</Base>
