---
import type { HomeCopy } from '../../data/home-copy';

interface Props { copy: HomeCopy; lang: 'en' | 'zh' }
const { copy, lang } = Astro.props;
const links = ['/docs/concepts/package-model', '/docs/concepts/compilation-snapshots', '/docs/start/connect-agent'];
const linkLabels = lang === 'zh' ? ['打开 Model 指南 ↗', '阅读 Snapshot 指南 ↗', '连接 Agent ↗'] : ['Open model guide ↗', 'Read snapshot guide ↗', 'Connect an agent ↗'];
---

<section class="home-section intro-section">
  <div class="section-inner">
    <div class="section-lead" data-reveal>
      <p class="section-eyebrow">{copy.introKicker}</p>
      <h2>{copy.introTitle}</h2>
      <p>{copy.introText}</p>
    </div>
    <div class="boundary-grid">
      {copy.cards.map(([number, title, text, label], index) => (
        <a class:list={{ 'boundary-card': true, 'boundary-card-featured': index === 1 }} data-reveal href={links[index]}>
          <div class="boundary-top"><span>{number}</span><span>{label}</span></div>
          <div class="boundary-mark">{index === 0 ? '◇' : index === 1 ? '◌' : '↗'}</div>
          <h3>{title}</h3>
          <p>{text}</p>
          <span class="boundary-link">{linkLabels[index]}</span>
        </a>
      ))}
    </div>
  </div>
</section>
