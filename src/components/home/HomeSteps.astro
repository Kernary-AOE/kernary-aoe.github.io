---
import type { HomeCopy } from '../../data/home-copy';
import { highlight } from '../../lib/highlight';

interface Props { copy: HomeCopy['steps']; prefix: (path: string) => string }
const { copy, prefix } = Astro.props;
---

<section class="section steps-section" id="steps">
  <div class="section-inner">
    <div class="section-head" data-reveal>
      <p class="section-eyebrow">{copy.kicker}</p>
      <h2 class="section-title">{copy.title}</h2>
      <p class="section-lede">{copy.lede}</p>
    </div>

    <ol class="steps-list">
      {copy.items.map((step, i) => (
        <li class="step-row" data-reveal style={`--reveal-delay:${i * 80}ms`}>
          <div class="step-num"><span>{step.number}</span></div>
          <div class="step-copy">
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
          <pre class="step-code"><code set:html={highlight(step.code)} /></pre>
        </li>
      ))}
    </ol>

    <p class="steps-foot" data-reveal><a class="text-link" href={prefix('/docs')}>{copy.link} <span class="arrow">→</span></a></p>
  </div>
</section>
