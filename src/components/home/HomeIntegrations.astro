---
import type { HomeCopy } from '../../data/home-copy';

interface Props { copy: HomeCopy; lang: 'en' | 'zh'; prefix: (path: string) => string }
const { copy, prefix } = Astro.props;
const isZh = Astro.props.lang === 'zh';
---

<section class="home-section connect-section">
  <div class="section-inner connect-inner">
    <div class="connect-copy" data-reveal>
      <p class="section-eyebrow">{copy.connectKicker}</p>
      <h2>{copy.connectTitle}</h2>
      <p>{copy.connectText}</p>
      <a class="text-link" href={prefix('/docs/start/connect-agent')}>{isZh ? '查看接入指南' : 'Read the integration guide'} <span>↗</span></a>
    </div>
    <div class="integration-panel" data-reveal>
      <div class="integration-tabs" role="tablist" aria-label={isZh ? '接入方式' : 'Integration methods'}>
        {copy.tabs.map(([id, label, description, snippet], index) => (
          <button class:list={{ active: index === 0 }} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-tab={id} data-label={label} data-code={snippet}>
            <span>{label}</span><small>{description}</small>
          </button>
        ))}
      </div>
      <div class="integration-code">
        <div class="code-chrome"><span><i></i><i></i><i></i></span><span id="integration-label">{copy.tabs[0][1]}</span><button id="copy-integration" type="button">{isZh ? '复制' : 'Copy'}</button></div>
        <pre id="integration-code" class="no-copy"><code>{copy.tabs[0][3]}</code></pre>
      </div>
    </div>
  </div>
</section>

<script>
  const panel = document.querySelector('.integration-panel');
  if (panel) {
    const tabs = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const code = panel.querySelector('#integration-code code');
    const label = panel.querySelector('#integration-label');
    const copyButton = panel.querySelector('#copy-integration');
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      tabs.forEach((item) => { const active = item === tab; item.classList.toggle('active', active); item.setAttribute('aria-selected', String(active)); });
      if (code && label && tab.dataset.code && tab.dataset.label) { code.textContent = tab.dataset.code; label.textContent = tab.dataset.label; }
    }));
    copyButton?.addEventListener('click', async () => {
      if (!code || !copyButton) return;
      await navigator.clipboard.writeText(code.textContent || '');
      const original = copyButton.textContent;
      copyButton.textContent = document.documentElement.lang.startsWith('zh') ? '已复制' : 'Copied';
      window.setTimeout(() => { copyButton.textContent = original; }, 1200);
    });
  }
</script>
