---
import type { HomeCopy } from '../../data/home-copy';

interface Props { copy: HomeCopy['cta']; prefix: (path: string) => string; github: string }
const { copy, prefix, github } = Astro.props;
---

<section class="cta" id="cta">
  <div class="cta-wash cta-wash-a" aria-hidden="true"></div>
  <div class="cta-wash cta-wash-b" aria-hidden="true"></div>
  <div class="cta-inner" data-reveal>
    <p class="section-eyebrow">{copy.kicker}</p>
    <h2>{copy.title}</h2>
    <p>{copy.text}</p>
    <div class="cta-actions">
      <a class="btn btn-primary btn-large" href={prefix('/docs')}>{copy.primary} <span class="arrow">→</span></a>
      <a class="btn btn-ghost btn-large" href={github} rel="noopener">{copy.secondary}</a>
    </div>
  </div>
</section>
