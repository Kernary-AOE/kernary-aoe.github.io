---
import type { HomeCopy } from '../../data/home-copy';
import { highlight } from '../../lib/highlight';

interface Props { copy: HomeCopy['intro']; prefix: (path: string) => string }
const { copy, prefix } = Astro.props;
---

<section class="section intro" id="what-it-is">
  <div class="section-inner">
    <div class="intro-head">
      <div class="intro-lead" data-reveal>
        <p class="section-eyebrow">{copy.kicker}</p>
        <h2 class="section-title">{copy.title}</h2>
      </div>
      <div class="intro-body" data-reveal>
        {copy.body.map((paragraph) => <p>{paragraph}</p>)}
        <a class="text-link" href={prefix('/docs/concepts/selection-execution')}>{copy.link} <span class="arrow">→</span></a>
      </div>
    </div>

    <div class="exchange" data-reveal>
      <figure class="exchange-side">
        <figcaption class="label">{copy.requestLabel}</figcaption>
        <pre class="exchange-code no-copy"><code set:html={highlight(copy.request)} /></pre>
      </figure>

      <div class="exchange-arrow" aria-hidden="true">
        <svg viewBox="0 0 64 200" preserveAspectRatio="none">
          <path class="exchange-track" d="M32 8 V192"/>
          <circle class="exchange-bead" cx="32" r="3.5"/>
        </svg>
        <span class="label">query</span>
      </div>

      <figure class="exchange-side exchange-plan">
        <figcaption class="label">{copy.planLabel}</figcaption>
        <div class="plan-card">
          <p class="plan-note">{copy.planNote}</p>
          <dl class="plan-rows">
            {copy.plan.map(([field, note], i) => (
              <div class="plan-row" style={`--i:${i}`}>
                <dt><code>{field}</code></dt>
                <dd>{note}</dd>
              </div>
            ))}
          </dl>
        </div>
      </figure>
    </div>
  </div>
</section>
