---
interface StageDetail {
  id: string;
  label: string;
  title: string;
  body: string;
  facts: readonly [string, string][];
  tokens: readonly [string, string][];
}

interface Props { lang?: 'en' | 'zh' }
const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';
const details: readonly StageDetail[] = isZh
  ? [
      { id: 'model', label: 'Model Package', title: '词汇由领域 Owner 定义。', body: 'Type、Relation、Projection、Retrieval 和 Action 都来自外部 Model Package。Engine 只读取声明，不预设领域对象。', facts: [['输入', 'types.yaml + relations.yaml'], ['产出', 'SchemaIR + model.lock'], ['变更', '领域包发布新版本']], tokens: [['Type', 'Ticket'], ['Relation', 'blocks'], ['Action', 'resolve']] },
      { id: 'compile', label: 'Compiler', title: '声明变成可复现的构建。', body: 'Parser、IR 和 Compiler 把模型与 Source Unit 组合起来，生成投影、索引、manifest 和内容摘要。', facts: [['检查', 'schema · relation · licence'], ['产出', 'Unit artifacts + _index.xml'], ['保证', '同一输入得到同一字节']], tokens: [['IR', '2.0'], ['Digest', 'sha256'], ['Index', 'deterministic']] },
      { id: 'snapshot', label: 'Verified Snapshot', title: 'Runtime 只接受完整快照。', body: 'Snapshot identity 绑定 Model、Corpus、Release 和 Digest。文件、索引或签名不匹配时，Runtime 在服务前拒绝加载。', facts: [['身份', 'tenant · corpus · release'], ['验证', 'manifest + content digest'], ['状态', 'immutable / addressable']], tokens: [['Model', 'locked'], ['Corpus', 'verified'], ['Release', 'active']] },
      { id: 'serve', label: 'Query & Action', title: '读取和写入走不同路径。', body: 'Query 生成带约束的 Selection Plan；Action 还要通过 Principal、Capability、Policy、Approval、Idempotency 和 Evidence。', facts: [['读取', 'SDK · MCP · HTTP'], ['规划', 'constraints + budget'], ['执行', 'policy-gated effects']], tokens: [['Plan', 'explainable'], ['Policy', 'deny-by-default'], ['Event', 'append-only']] },
    ]
  : [
      { id: 'model', label: 'Model Package', title: 'The domain owner defines the vocabulary.', body: 'Types, relations, projections, retrieval, and actions arrive from an external Model Package. The Engine reads declarations; it does not guess domain objects.', facts: [['Input', 'types.yaml + relations.yaml'], ['Output', 'SchemaIR + model.lock'], ['Change', 'publish a new domain version']], tokens: [['Type', 'Ticket'], ['Relation', 'blocks'], ['Action', 'resolve']] },
      { id: 'compile', label: 'Compiler', title: 'Declarations become a reproducible build.', body: 'Parser, IR, and Compiler combine the model with source units to emit projections, an index, a manifest, and content digests.', facts: [['Checks', 'schema · relation · licence'], ['Output', 'Unit artifacts + _index.xml'], ['Guarantee', 'same input, same bytes']], tokens: [['IR', '2.0'], ['Digest', 'sha256'], ['Index', 'deterministic']] },
      { id: 'snapshot', label: 'Verified Snapshot', title: 'Runtime accepts complete snapshots only.', body: 'Snapshot identity binds Model, Corpus, Release, and Digest. A changed file, index, or signature is refused before serving.', facts: [['Identity', 'tenant · corpus · release'], ['Checks', 'manifest + content digest'], ['State', 'immutable / addressable']], tokens: [['Model', 'locked'], ['Corpus', 'verified'], ['Release', 'active']] },
      { id: 'serve', label: 'Query & Action', title: 'Reads and writes take different paths.', body: 'Query produces a constrained Selection Plan. Action additionally requires a Principal, Capability, Policy, Approval, Idempotency, and Evidence.', facts: [['Read', 'SDK · MCP · HTTP'], ['Plan', 'constraints + budget'], ['Execute', 'policy-gated effects']], tokens: [['Plan', 'explainable'], ['Policy', 'deny-by-default'], ['Event', 'append-only']] },
    ];
---

<section class="architecture section" aria-labelledby="architecture-title">
  <div class="section-inner">
    <div class="architecture-head">
      <div><p class="section-eyebrow">{isZh ? '运行时结构' : 'Runtime shape'}</p><h2 id="architecture-title" class="architecture-title">{isZh ? '一个 Runtime，四个边界。' : 'One runtime. Four boundaries.'}</h2></div>
      <div class="architecture-badge"><span class="pulse-dot"></span> {isZh ? '可验证状态' : 'Verified state'}</div>
    </div>
    <p class="architecture-intro">{isZh ? '选择一个边界，查看它实际拥有的输入、产出与保证。' : 'Select a boundary to inspect the inputs, outputs, and guarantees it owns.'}</p>

    <div class="architecture-grid">
      <nav class="architecture-steps" aria-label={isZh ? '运行时边界' : 'Runtime boundaries'}>
        {details.map((detail, index) => <button class:list={{ 'architecture-step': true, active: index === 0 }} type="button" aria-selected={index === 0 ? 'true' : 'false'} data-stage={detail.id}><span class="step-index">0{index + 1}</span><span><strong>{detail.label}</strong><small>{detail.facts[0][1]}</small></span><span class="step-arrow">↗</span></button>)}
      </nav>

      <div class="architecture-detail" aria-live="polite">
        {details.map((detail, index) => <article class:list={{ 'detail-panel': true, active: index === 0 }} data-detail={detail.id}>
          <div class="detail-top"><span>{detail.label}</span><span class="detail-index">0{index + 1} / 04</span></div>
          <h3>{detail.title}</h3><p class="detail-body">{detail.body}</p>
          <div class="detail-columns"><dl>{detail.facts.map(([key, value]) => <div><dt>{key}</dt><dd>{value}</dd></div>)}</dl><div class="detail-tokens" aria-label={isZh ? '阶段内容' : 'Stage contents'}>{detail.tokens.map(([key, value]) => <div class="detail-token"><span>{key}</span><b>{value}</b></div>)}</div></div>
        </article>)}
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('.architecture');
  if (root) {
    const steps = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-stage]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-detail]'));
    steps.forEach((step) => step.addEventListener('click', () => {
      const selected = step.dataset.stage;
      steps.forEach((item) => { const active = item === step; item.classList.toggle('active', active); item.setAttribute('aria-selected', String(active)); });
      panels.forEach((panel) => panel.classList.toggle('active', panel.dataset.detail === selected));
    }));
  }
</script>

<style>
  .architecture { --arch-paper: var(--home-paper, #f5f2ed); --arch-surface: var(--home-card, rgba(255,255,255,.35)); --arch-fg: var(--home-fg, #11131b); --arch-muted: var(--home-muted, #77736e); --arch-line: var(--home-line, rgba(17,19,27,.16)); --arch-cyan: #11a4ba; --arch-violet: #7569f6; background: var(--arch-paper); border-top: 1px solid var(--arch-line); }
  :global(:root[data-theme="dark"]) .architecture { --arch-paper: var(--home-paper, #0d1017); --arch-surface: var(--home-card, #151923); --arch-fg: var(--home-fg, #f0f1f4); --arch-muted: var(--home-muted, #a0a5b1); --arch-line: var(--home-line, rgba(255,255,255,.16)); --arch-cyan: #65d9e8; --arch-violet: #9b93ff; }
  .architecture-head { display:flex; justify-content:space-between; align-items:end; gap:24px; } .architecture-title { margin:0; color:var(--arch-fg); font:400 clamp(38px,5vw,68px)/.98 Georgia,'Times New Roman',serif; letter-spacing:-.05em; } .architecture .section-eyebrow { color:var(--arch-violet); } .architecture-badge { flex:none; border:1px solid var(--arch-line); border-radius:999px; padding:8px 12px; color:var(--arch-muted); font:12px var(--font-mono); } .pulse-dot { display:inline-block; width:7px; height:7px; border-radius:50%; background:#57c879; box-shadow:0 0 0 4px rgba(87,200,121,.15); animation:aoe-pulse 2s ease-in-out infinite; }
  .architecture-intro { margin:20px 0 0; color:var(--arch-muted); font-size:17px; line-height:1.55; }
  .architecture-grid { display:grid; grid-template-columns:minmax(260px,.72fr) minmax(0,1.28fr); gap:36px; align-items:start; margin-top:42px; } .architecture-steps { display:flex; flex-direction:column; gap:8px; } .architecture-step { display:grid; grid-template-columns:32px minmax(0,1fr) 18px; gap:12px; align-items:center; width:100%; padding:17px 16px; border:1px solid var(--arch-line); border-radius:4px; color:var(--arch-fg); background:transparent; text-align:left; cursor:pointer; transition:border-color 180ms ease,background 180ms ease,transform 180ms ease; } .architecture-step:hover,.architecture-step.active { border-color:var(--arch-cyan); background:color-mix(in srgb,var(--arch-cyan) 8%,var(--arch-paper)); transform:translateX(3px); } .architecture-step strong { display:block; font-size:14px; } .architecture-step small { display:block; margin-top:4px; color:var(--arch-muted); font-size:11px; line-height:1.45; } .step-index { color:var(--arch-cyan); font:12px var(--font-mono); } .step-arrow { color:var(--arch-muted); transition:transform 180ms ease,color 180ms ease; } .architecture-step.active .step-arrow { color:var(--arch-cyan); transform:translate(2px,-2px); }
  .architecture-detail { min-height:370px; border:1px solid var(--arch-line); border-radius:4px; background:var(--arch-surface); overflow:hidden; } .detail-panel { display:none; padding:26px 30px 30px; animation:detail-enter 240ms ease both; } .detail-panel.active { display:block; } .detail-top { display:flex; justify-content:space-between; color:var(--arch-muted); font:11px var(--font-mono); letter-spacing:.07em; text-transform:uppercase; } .detail-index { color:var(--arch-cyan); } .detail-panel h3 { max-width:620px; margin:62px 0 17px; color:var(--arch-fg); font:400 clamp(30px,3.5vw,48px)/1 Georgia,serif; letter-spacing:-.045em; } .detail-body { max-width:620px; margin:0; color:var(--arch-muted); font-size:16px; line-height:1.6; } .detail-columns { display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-top:46px; padding-top:20px; border-top:1px solid var(--arch-line); } .detail-columns dl { margin:0; } .detail-columns dl > div { display:flex; justify-content:space-between; gap:14px; padding:9px 0; border-bottom:1px solid var(--arch-line); font:11px var(--font-mono); } .detail-columns dt { color:var(--arch-muted); } .detail-columns dd { margin:0; color:var(--arch-fg); text-align:right; } .detail-tokens { display:flex; flex-wrap:wrap; align-content:start; gap:7px; } .detail-token { display:flex; flex-direction:column; min-width:105px; padding:10px 11px; border:1px solid var(--arch-line); border-radius:3px; background:color-mix(in srgb,var(--arch-paper) 70%,transparent); } .detail-token span { color:var(--arch-muted); font:10px var(--font-mono); text-transform:uppercase; } .detail-token b { margin-top:5px; color:var(--arch-fg); font:12px var(--font-mono); font-weight:500; }
  @keyframes detail-enter { from { opacity:0; transform:translateY(5px); } to { opacity:1; transform:none; } } @keyframes aoe-pulse { 0%,100% { opacity:.6; transform:scale(.9); } 50% { opacity:1; transform:scale(1.15); } }
  @media (max-width:760px) { .architecture-head { align-items:start; flex-direction:column; } .architecture-grid { grid-template-columns:1fr; gap:20px; } .architecture-detail { min-height:0; } .detail-panel { padding:22px 18px 20px; } .detail-panel h3 { margin-top:42px; font-size:32px; } .detail-columns { grid-template-columns:1fr; margin-top:34px; } }
  @media (prefers-reduced-motion:reduce) { .pulse-dot,.detail-panel { animation:none; } .architecture-step,.step-arrow { transition:none; } }
</style>
