---
import Mermaid from './Mermaid.astro';

interface Props { lang?: 'en' | 'zh' }
const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';
const graph = `flowchart LR
  M[Model Package] --> C[Compiler]
  U[Corpus Package] --> C
  C --> S[Verified Snapshot]
  S --> Q[Query / Selection Plan]
  S --> A[Action / Execution Plan]
  Q --> H[SDK · MCP · HTTP]
  A --> H
  classDef input fill:#17202a,stroke:#2bb3cc,color:#e8eaed
  classDef core fill:#17202a,stroke:#6f7bf7,color:#e8eaed
  classDef output fill:#17202a,stroke:#52d273,color:#e8eaed
  class M,U input
  class C,S core
  class Q,A,H output`;

const steps = isZh
  ? [
      ['model', 'Model Package', '类型、关系、投影、检索与 Action 的声明。'],
      ['compile', 'Compile', '解析、校验、生成并绑定内容摘要。'],
      ['snapshot', 'Verified Snapshot', '可定位、可复现、可验证的运行时输入。'],
      ['serve', 'Query & Action', '按同一契约查询、规划并执行受控操作。'],
    ]
  : [
      ['model', 'Model Package', 'Types, relations, projections, retrieval, and actions.'],
      ['compile', 'Compile', 'Parse, validate, emit, and bind content digests.'],
      ['snapshot', 'Verified Snapshot', 'A reproducible, addressable runtime input.'],
      ['serve', 'Query & Action', 'Query, plan, and execute through one contract.'],
    ];
---

<section class="architecture section" aria-labelledby="architecture-title">
  <div class="section-inner">
    <div class="architecture-head">
      <div>
        <p class="section-eyebrow">{isZh ? '运行时结构' : 'Runtime shape'}</p>
        <h2 id="architecture-title" class="section-title" style="border: 0; padding: 0; margin-top: 0;">
          {isZh ? '从领域声明到可调用 Runtime' : 'From domain declarations to a callable runtime'}
        </h2>
        <p class="section-lede">
          {isZh ? '点击阶段，查看每一步在 AOE 中承担的边界。' : 'Select a stage to see the boundary it owns in AOE.'}
        </p>
      </div>
      <div class="architecture-badge"><span class="pulse-dot"></span> {isZh ? '可验证数据流' : 'Verified data flow'}</div>
    </div>

    <div class="architecture-grid">
      <div class="architecture-steps" role="tablist" aria-label={isZh ? '运行时阶段' : 'Runtime stages'}>
        {steps.map(([id, title, text], index) => (
          <button class:list={{ 'architecture-step': true, active: index === 0 }} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-stage={id}>
            <span class="step-index">0{index + 1}</span>
            <span><strong>{title}</strong><small>{text}</small></span>
            <span class="step-arrow">↗</span>
          </button>
        ))}
        <div class="architecture-note" id="architecture-note" aria-live="polite">
          {steps[0][2]}
        </div>
      </div>
      <div class="architecture-diagram">
        <div class="diagram-toolbar"><span>aoe / runtime</span><span>{isZh ? '拖动页面继续探索' : 'Scroll to explore'}</span></div>
        <Mermaid>{graph}</Mermaid>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('.architecture');
  if (root) {
    const note = root.querySelector('#architecture-note');
    const steps = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-stage]'));
    steps.forEach((step) => step.addEventListener('click', () => {
      steps.forEach((item) => {
        const active = item === step;
        item.classList.toggle('active', active);
        item.setAttribute('aria-selected', String(active));
      });
      const text = step.querySelector('small')?.textContent;
      if (note && text) note.textContent = text;
    }));
  }
</script>

<style>
  .architecture { border-top: 1px solid var(--border-muted); }
  .architecture-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; }
  .architecture-badge { flex: none; border: 1px solid var(--border-default); border-radius: 999px; padding: 8px 12px; color: var(--fg-muted); font: 12px var(--font-mono); }
  .pulse-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--success-fg); box-shadow: 0 0 0 4px color-mix(in srgb, var(--success-fg) 18%, transparent); animation: aoe-pulse 2s ease-in-out infinite; }
  .architecture-grid { display: grid; grid-template-columns: minmax(260px, .8fr) minmax(0, 1.2fr); gap: 24px; align-items: stretch; margin-top: 28px; }
  .architecture-steps { display: flex; flex-direction: column; gap: 8px; }
  .architecture-step { display: grid; grid-template-columns: 34px 1fr 20px; gap: 12px; align-items: center; width: 100%; border: 1px solid var(--border-default); border-radius: var(--r-2); padding: 14px 16px; color: var(--fg-default); background: var(--bg-canvas); text-align: left; cursor: pointer; transition: border-color 180ms ease, transform 180ms ease, background 180ms ease; }
  .architecture-step:hover, .architecture-step.active { border-color: var(--accent-emphasis); background: var(--accent-subtle); transform: translateX(3px); }
  .architecture-step strong { display: block; font-size: 14px; }
  .architecture-step small { display: block; margin-top: 3px; color: var(--fg-muted); font-size: 12px; line-height: 1.45; }
  .step-index { color: var(--accent-fg); font: 12px var(--font-mono); }
  .step-arrow { color: var(--accent-fg); text-align: right; opacity: .7; }
  .architecture-note { min-height: 44px; padding: 12px 16px; color: var(--fg-muted); font-size: 13px; line-height: 1.55; border-left: 2px solid var(--accent-emphasis); }
  .architecture-diagram { min-height: 330px; border: 1px solid var(--border-default); border-radius: var(--r-2); background: var(--bg-subtle); overflow: hidden; }
  .diagram-toolbar { display: flex; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid var(--border-muted); color: var(--fg-muted); font: 11px var(--font-mono); text-transform: uppercase; letter-spacing: .06em; }
  .architecture-diagram .mermaid-wrapper { display: grid; min-height: 275px; place-items: center; padding: 20px; }
  .architecture-diagram :global(svg) { max-width: 100%; height: auto; }
  @keyframes aoe-pulse { 0%, 100% { opacity: .55; transform: scale(.9); } 50% { opacity: 1; transform: scale(1.15); } }
  @media (max-width: 760px) { .architecture-head { align-items: start; flex-direction: column; } .architecture-grid { grid-template-columns: 1fr; } .architecture-diagram { min-height: 280px; } }
  @media (prefers-reduced-motion: reduce) { .pulse-dot { animation: none; } .architecture-step { transition: none; } }
</style>
