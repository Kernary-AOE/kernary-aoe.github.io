---
import '../styles/global.css';
import '../styles/mermaid.css';
import { SITE as PRODUCT } from '../config/site';

interface Props {
  title: string;
  description?: string;
  current?: 'home' | 'marketplace' | 'docs' | 'browse' | 'blog' | 'about';
  lang?: 'en' | 'zh';
  image?: string;
  type?: 'website' | 'article';
  published?: string;
}

const {
  title,
  description,
  current,
  lang = 'en',
  image = '/og-default.png',
  type = 'website',
  published,
} = Astro.props;
const isZh = lang === 'zh';
const fullTitle = title === PRODUCT.name ? `${PRODUCT.name} · ${PRODUCT.category}` : `${title} · ${PRODUCT.name}`;
const desc = description ?? (isZh ? PRODUCT.descriptionZh : PRODUCT.description);

const siteUrl = (import.meta.env.SITE as string | undefined) ?? 'https://kernary-aoe.github.io';
const pathname = Astro.url.pathname;
const canonicalUrl = new URL(pathname, siteUrl).toString();
const ogImage = new URL(image, siteUrl).toString();
const ogLocale = isZh ? 'zh_CN' : 'en_US';

function stripZh(path: string): string {
  if (path === '/zh' || path === '/zh/') return '/';
  return path.startsWith('/zh/') ? path.slice(3) : path;
}
function addZh(path: string): string {
  if (path === '/' || path === '') return '/zh';
  return `/zh${path}`;
}
const enPath = pathname.startsWith('/zh') ? stripZh(pathname) : pathname;
const zhPath = pathname.startsWith('/zh') ? pathname : addZh(pathname);

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: PRODUCT.name,
  applicationCategory: 'DeveloperApplication',
  description: desc,
  url: siteUrl,
  codeRepository: PRODUCT.github,
  license: PRODUCT.license,
};
const articleLd = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: desc,
  image: ogImage,
  datePublished: published,
  author: { '@type': 'Organization', name: PRODUCT.name },
  publisher: { '@type': 'Organization', name: PRODUCT.name },
  mainEntityOfPage: canonicalUrl,
} : null;

const labels = isZh
  ? { packages: 'Packages', docs: '文档', blog: '日志', about: '关于', switch: 'EN', start: '开始构建', menu: '菜单', announce: 'AOE 0.2 · Agent Ontology Engine 现已发布', announceCta: '阅读更新' }
  : { packages: 'Packages', docs: 'Docs', blog: 'Blog', about: 'About', switch: '中文', start: 'Start building', menu: 'Menu', announce: 'AOE 0.2 · Agent Ontology Engine is out', announceCta: 'Read the update' };
const homeHref = isZh ? '/zh' : '/';
const prefix = (path: string) => isZh ? `/zh${path}` : path;
---
<!doctype html>
<html lang={isZh ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" type="image/svg+xml" href="/aoe-mark-mono.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, siteUrl).toString()} />
    <link rel="alternate" hreflang="zh" href={new URL(zhPath, siteUrl).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, siteUrl).toString()} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={PRODUCT.name} />
    {type === 'article' && published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f6f3ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101011" media="(prefers-color-scheme: dark)" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {articleLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('aoe-theme');
          const dark = window.matchMedia?.('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = saved === 'dark' ? 'dark' : saved === 'light' ? 'light' : dark ? 'dark' : 'light';
        } catch {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" />
  </head>
  <body class:list={{ 'is-home': current === 'home' }}>
    <a class="skip" href="#main">Skip to content</a>

    {current === 'home' && (
      <div class="announce">
        <span>{labels.announce}</span>
        <a href={prefix('/blog')}>{labels.announceCta} →</a>
      </div>
    )}

    <header class="site-header" id="site-header">
      <div class="site-header-inner">
        <a class="brand" href={homeHref} aria-label="AOE home">
          <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
            <circle cx="32" cy="32" r="30" fill="currentColor"/>
            <circle cx="32" cy="32" r="15" fill="none" stroke="var(--bg-canvas)" stroke-width="2.6"/>
            <circle cx="32" cy="32" r="5.5" fill="var(--bg-canvas)"/>
            <path d="M32 17V8M32 56v-9M17 32H8M56 32h-9" stroke="var(--bg-canvas)" stroke-width="2.6" stroke-linecap="round"/>
          </svg>
          <span>AOE</span>
          <span class="brand-tag">v{PRODUCT.version}</span>
        </a>
        <nav class="site-nav" id="site-nav" aria-label="Primary">
          <a href={prefix('/marketplace')} aria-current={current === 'marketplace' || current === 'browse' ? 'page' : undefined}>{labels.packages}</a>
          <a href={prefix('/docs')} aria-current={current === 'docs' ? 'page' : undefined}>{labels.docs}</a>
          <a href={prefix('/blog')} aria-current={current === 'blog' ? 'page' : undefined}>{labels.blog}</a>
          <a href={prefix('/about')} aria-current={current === 'about' ? 'page' : undefined}>{labels.about}</a>
          <a class="nav-mobile-only" href={PRODUCT.github} rel="noopener">GitHub ↗</a>
        </nav>
        <div class="site-actions">
          <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme" type="button">
            <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
            <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
          <a href={isZh ? enPath : zhPath} aria-label="Switch language">{labels.switch}</a>
          <a class="nav-gh" href={PRODUCT.github} rel="noopener">GitHub</a>
          <a class="nav-cta" href={prefix('/docs')}>{labels.start}</a>
          <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">{labels.menu}</button>
        </div>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="footer-brand">
          <a class="brand" href={homeHref}>
            <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
              <circle cx="32" cy="32" r="30" fill="currentColor"/>
              <circle cx="32" cy="32" r="15" fill="none" stroke="var(--bg-canvas)" stroke-width="2.6"/>
              <circle cx="32" cy="32" r="5.5" fill="var(--bg-canvas)"/>
              <path d="M32 17V8M32 56v-9M17 32H8M56 32h-9" stroke="var(--bg-canvas)" stroke-width="2.6" stroke-linecap="round"/>
            </svg>
            <span>AOE</span>
          </a>
          <p>{isZh ? PRODUCT.descriptionZh : PRODUCT.description}</p>
          <p class="label">{isZh ? 'Apache-2.0 许可' : 'Apache-2.0 licensed'}</p>
        </div>
        <div>
          <h4>{isZh ? '开始' : 'Start'}</h4>
          <ul>
            <li><a href={prefix('/docs')}>{labels.docs}</a></li>
            <li><a href={prefix('/docs/start/connect-agent')}>{isZh ? '连接 Agent' : 'Connect an Agent'}</a></li>
            <li><a href={prefix('/marketplace')}>{labels.packages}</a></li>
          </ul>
        </div>
        <div>
          <h4>{isZh ? '构建' : 'Build'}</h4>
          <ul>
            <li><a href={prefix('/docs/concepts/package-model')}>{isZh ? 'Package 模型' : 'Package model'}</a></li>
            <li><a href={prefix('/docs/concepts/compilation-snapshots')}>{isZh ? '编译与 Snapshot' : 'Compilation and snapshots'}</a></li>
            <li><a href={prefix('/docs/concepts/selection-execution')}>{isZh ? 'Selection 与 Execution' : 'Selection and execution'}</a></li>
          </ul>
        </div>
        <div>
          <h4>{isZh ? '项目' : 'Project'}</h4>
          <ul>
            <li><a href={prefix('/blog')}>{labels.blog}</a></li>
            <li><a href={prefix('/about')}>{labels.about}</a></li>
            <li><a href={PRODUCT.github} rel="noopener">GitHub</a></li>
            <li><a href={PRODUCT.license} rel="noopener">License</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-wordmark" aria-hidden="true">Agent Ontology Engine</div>
      <div class="site-footer-bottom">
        <span>© 2026 AOE contributors</span>
        <span>{isZh ? '把领域知识编译为可执行系统' : 'Domain knowledge, made executable'}</span>
      </div>
    </footer>

    <script>
      const header = document.getElementById('site-header');
      const navToggle = document.getElementById('nav-toggle');
      const onScroll = () => header?.classList.toggle('is-stuck', window.scrollY > 24);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      navToggle?.addEventListener('click', () => {
        const open = header?.classList.toggle('is-open') ?? false;
        navToggle.setAttribute('aria-expanded', String(open));
      });

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('aoe-theme', next); } catch {}
      });

      const labels = document.documentElement.lang.startsWith('zh')
        ? { copy: '复制', copied: '已复制' }
        : { copy: 'Copy', copied: 'Copied' };
      document.querySelectorAll<HTMLPreElement>('pre:not(.mermaid):not(.no-copy):not([data-mermaid-src])').forEach((pre) => {
        if (pre.querySelector(':scope > .copy-btn') || pre.closest('.mermaid-wrapper')) return;
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'copy-btn';
        button.textContent = labels.copy;
        button.addEventListener('click', async () => {
          const text = Array.from(pre.childNodes).filter((node) => node !== button).map((node) => node.textContent ?? '').join('');
          await navigator.clipboard.writeText(text);
          button.textContent = labels.copied;
          window.setTimeout(() => { button.textContent = labels.copy; }, 1200);
        });
        pre.appendChild(button);
      });

      // Generic scroll reveal for any page that opts in with data-reveal.
      const reveal = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (entry.isIntersecting) { entry.target.classList.add('is-visible'); reveal.unobserve(entry.target); }
      }), { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('[data-reveal]').forEach((element) => reveal.observe(element));
    </script>
  </body>
</html>
