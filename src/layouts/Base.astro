---
import '../styles/global.css';
import '../styles/mermaid.css';
import { SITE as PRODUCT } from '../config/site';

interface Props {
  title: string;
  description?: string;
  current?: 'home' | 'marketplace' | 'docs' | 'browse' | 'blog' | 'about';
  lang?: 'en' | 'zh';
  image?: string;
  type?: 'website' | 'article';
  published?: string;
}

const {
  title,
  description,
  current,
  lang = 'en',
  image = '/og-default.png',
  type = 'website',
  published,
} = Astro.props;
const isZh = lang === 'zh';
const fullTitle = title === PRODUCT.name ? title : `${title} · ${PRODUCT.name}`;
const desc = description ?? (isZh ? PRODUCT.descriptionZh : PRODUCT.description);

const siteUrl = (import.meta.env.SITE as string | undefined) ?? 'https://kernary-aoe.github.io';
const pathname = Astro.url.pathname;
const canonicalUrl = new URL(pathname, siteUrl).toString();
const ogImage = new URL(image, siteUrl).toString();
const ogLocale = isZh ? 'zh_CN' : 'en_US';

function stripZh(path: string): string {
  if (path === '/zh' || path === '/zh/') return '/';
  return path.startsWith('/zh/') ? path.slice(3) : path;
}
function addZh(path: string): string {
  if (path === '/' || path === '') return '/zh';
  return `/zh${path}`;
}
const enPath = pathname.startsWith('/zh') ? stripZh(pathname) : pathname;
const zhPath = pathname.startsWith('/zh') ? pathname : addZh(pathname);

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: PRODUCT.name,
  applicationCategory: 'DeveloperApplication',
  description: desc,
  url: siteUrl,
  codeRepository: PRODUCT.github,
  license: PRODUCT.license,
};
const articleLd = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: desc,
  image: ogImage,
  datePublished: published,
  author: { '@type': 'Organization', name: PRODUCT.name },
  publisher: { '@type': 'Organization', name: PRODUCT.name },
  mainEntityOfPage: canonicalUrl,
} : null;

const labels = isZh ? {
  packages: 'Packages', docs: '文档', blog: '日志', about: '关于', switch: 'EN',
} : {
  packages: 'Packages', docs: 'Docs', blog: 'Blog', about: 'About', switch: '中',
};
const homeHref = isZh ? '/zh' : '/';
const prefix = (path: string) => isZh ? `/zh${path}` : path;
---
<!doctype html>
<html lang={isZh ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" type="image/svg+xml" href="/aoe-mark.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, siteUrl).toString()} />
    <link rel="alternate" hreflang="zh" href={new URL(zhPath, siteUrl).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, siteUrl).toString()} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={PRODUCT.name} />
    {type === 'article' && published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {articleLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('aoe-theme') || localStorage.getItem('sw-theme');
          const dark = window.matchMedia?.('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = saved === 'dark' ? 'dark' : saved === 'light' ? 'light' : dark ? 'dark' : 'light';
        } catch {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" />
  </head>
  <body class:list={{ 'aoe-home-body': current === 'home' }}>
    <a class="skip" href="#main">Skip to content</a>
    {current === 'home' && <div class="home-announcement"><span>{isZh ? 'AOE 0.2 · Agent Ontology Engine' : 'AOE 0.2 · Agent Ontology Engine'}</span><a href={prefix('/blog')}>{isZh ? '查看更新 ↗' : 'Read the update ↗'}</a></div>}
    <header class="gh-header">
      <div class="gh-header-inner">
        <a class="gh-brand" href={homeHref} aria-label="AOE home">
          <img src="/aoe-mark.svg" alt="" width="24" height="24" aria-hidden="true" />
          {PRODUCT.name}
          <span class="gh-brand-tag">v{PRODUCT.version}</span>
        </a>
        <div class="gh-search" role="search">
          <input type="search" placeholder={isZh ? '搜索 Package、文档、示例…' : 'Search packages, docs, examples…'} aria-label={isZh ? '搜索' : 'Search'} />
          <kbd>⌘ K</kbd>
        </div>
        <nav class="gh-nav" aria-label="Primary">
          <a href={prefix('/marketplace')} aria-current={current === 'marketplace' || current === 'browse' ? 'page' : undefined}>{labels.packages}</a>
          <a href={prefix('/docs')} aria-current={current === 'docs' ? 'page' : undefined}>{labels.docs}</a>
          <a href={prefix('/blog')} aria-current={current === 'blog' ? 'page' : undefined}>{labels.blog}</a>
          <a href={prefix('/about')} aria-current={current === 'about' ? 'page' : undefined}>{labels.about}</a>
        </nav>
        <div class="gh-meta">
          <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme" type="button">◐</button>
          <a href={isZh ? '/' : '/zh'} aria-label="Switch language">{labels.switch}</a>
          <a href={PRODUCT.github} rel="noopener" aria-label="AOE engine on GitHub">GitHub ↗</a>
        </div>
      </div>
    </header>

    <main id="main" class:list={{ 'aoe-home-main': current === 'home' }}><slot /></main>

    <footer class="gh-footer">
      <div class="gh-footer-inner">
        <div class="gh-footer-meta">
          <strong>{PRODUCT.name}</strong> v{PRODUCT.version}<br />
          {isZh ? PRODUCT.descriptionZh : PRODUCT.description}<br /><br />
          Apache-2.0 licensed.
        </div>
        <div>
          <h4>{isZh ? '开始' : 'Start'}</h4>
          <ul>
            <li><a href={prefix('/docs')}>{labels.docs}</a></li>
            <li><a href={prefix('/docs/start/connect-agent')}>{isZh ? '连接 Agent' : 'Connect an Agent'}</a></li>
            <li><a href={prefix('/marketplace')}>{labels.packages}</a></li>
          </ul>
        </div>
        <div>
          <h4>{isZh ? '构建' : 'Build'}</h4>
          <ul>
            <li><a href={prefix('/docs/concepts/package-model')}>{isZh ? 'Package 模型' : 'Package model'}</a></li>
            <li><a href={prefix('/docs/concepts/compilation-snapshots')}>{isZh ? '编译与 Snapshot' : 'Compilation and snapshots'}</a></li>
            <li><a href={prefix('/docs/concepts/selection-execution')}>{isZh ? 'Selection 与 Execution' : 'Selection and execution'}</a></li>
          </ul>
        </div>
        <div>
          <h4>{isZh ? '项目' : 'Project'}</h4>
          <ul>
            <li><a href={prefix('/blog')}>{labels.blog}</a></li>
            <li><a href={prefix('/about')}>{labels.about}</a></li>
            <li><a href={PRODUCT.github} rel="noopener">GitHub</a></li>
            <li><a href={PRODUCT.license} rel="noopener">License</a></li>
          </ul>
        </div>
      </div>
      <div class="gh-footer-bottom">
        <span>© 2026 AOE contributors. Apache-2.0.</span>
        <span>{isZh ? 'AOE · 面向 Agent 的本体引擎' : 'AOE · Agent Ontology Engine'}</span>
      </div>
    </footer>

    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
          try { localStorage.setItem('aoe-theme', next); } catch {}
      });

      const labels = document.documentElement.lang.startsWith('zh')
        ? { copy: '复制', copied: '已复制' }
        : { copy: 'Copy', copied: 'Copied' };
      document.querySelectorAll<HTMLPreElement>('pre:not(.mermaid):not(.no-copy):not([data-mermaid-src])').forEach((pre) => {
        if (pre.querySelector(':scope > .copy-btn') || pre.closest('.mermaid-wrapper')) return;
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'copy-btn';
        button.textContent = labels.copy;
        button.addEventListener('click', async () => {
          const text = Array.from(pre.childNodes).filter((node) => node !== button).map((node) => node.textContent ?? '').join('');
          await navigator.clipboard.writeText(text);
          button.textContent = labels.copied;
          window.setTimeout(() => { button.textContent = labels.copy; }, 1200);
        });
        pre.appendChild(button);
      });
    </script>
  </body>
</html>
