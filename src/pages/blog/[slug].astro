---
import Base from '../../layouts/Base.astro';
import { loadPosts } from '../../lib/blog';

export function getStaticPaths() {
  return loadPosts()
    .filter((p) => p.lang === 'en')
    .map((p) => ({
      params: { slug: p.slug },
      props: { post: p },
    }));
}

const { post } = Astro.props as { post: ReturnType<typeof loadPosts>[number] };
---
<Base title={post.title} current="blog" description={post.excerpt}>
  <article class="post">
    <p class="post-back"><a href="/blog">← All posts</a></p>
    <header class="post-head">
      <p class="post-meta">{post.date} · {post.reading}</p>
      <h1 class="post-title">{post.title}</h1>
      <p class="post-deck">{post.excerpt}</p>
    </header>
    <div class="post-body" set:html={post.bodyHtml}></div>
    <footer class="post-foot">
      <p>
        <a href="/blog">← All posts</a>
        <a href="/marketplace">Browse packages →</a>
      </p>
    </footer>
  </article>
</Base>
