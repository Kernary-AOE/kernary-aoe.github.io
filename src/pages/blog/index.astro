---
import Base from '../../layouts/Base.astro';
import { loadPosts } from '../../lib/blog';

const posts = loadPosts().filter((p) => p.lang === 'en');
---
<Base
  title="Blog"
  current="blog"
  description="Release notes and field notes from building the Agent Ontology Engine."
>
  <div class="blog-list-wrap">
    <header class="blog-list-head">
      <div data-reveal>
        <p class="blog-list-eyebrow label">Blog · {posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
        <h1 class="blog-list-title">Notes from the engine.</h1>
      </div>
      <p class="blog-list-lede" data-reveal>
        Release notes and field notes from building the Agent Ontology Engine
        for domains, agents, and applications.
      </p>
    </header>

    <div class="blog-list">
      {posts.map((p, i) => (
        <a class="blog-row" href={`/blog/${p.slug}`} data-reveal style={`--reveal-delay:${i * 60}ms`}>
          <div class="blog-row-meta">
            <span class="blog-row-date">{p.date}</span>
            <span class="blog-row-reading">{p.reading}</span>
          </div>
          <div>
            <h2 class="blog-row-title">{p.title}</h2>
            <p class="blog-row-excerpt">{p.excerpt}</p>
          </div>
          <span class="blog-row-cta">Read post →</span>
        </a>
      ))}
    </div>
  </div>
</Base>
