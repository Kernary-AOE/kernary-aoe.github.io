---
import Base from '../../../layouts/Base.astro';
import { loadPosts } from '../../../lib/blog';

const posts = loadPosts().filter((p) => p.lang === 'zh');
---
<Base
  title="日志"
  current="blog"
  lang="zh"
  description="发布日志、设计笔记与一线实践 —— 关于构建 Agent Ontology Engine 的过程记录。"
>
  <div class="blog-list-wrap">
    <header class="blog-list-head">
      <div data-reveal>
        <p class="blog-list-eyebrow label">日志 · {posts.length} 篇</p>
        <h1 class="blog-list-title">来自引擎的笔记。</h1>
      </div>
      <p class="blog-list-lede" data-reveal>
        发布说明、设计笔记与一线实践 —— 关于为领域、Agent 与应用构建 Agent Ontology Engine 的过程。
      </p>
    </header>

    {posts.length === 0 ? (
      <p style="color: var(--fg-muted); padding: 32px 0;">
        中文日志建设中。请先看 <a href="/blog">英文版</a>。
      </p>
    ) : (
      <div class="blog-list">
        {posts.map((p, i) => (
          <a class="blog-row" href={`/zh/blog/${p.slug}`} data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <div class="blog-row-meta">
              <span class="blog-row-date">{p.date}</span>
              <span class="blog-row-reading">{p.reading}</span>
            </div>
            <div>
              <h2 class="blog-row-title">{p.title}</h2>
              <p class="blog-row-excerpt">{p.excerpt}</p>
            </div>
            <span class="blog-row-cta">阅读 →</span>
          </a>
        ))}
      </div>
    )}
  </div>
</Base>
